{
  "name": "ack-receipts",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "On-chain delivery acknowledgment receipts for Solana.",
  "author": "Royal Pinto <royalpinto007@gmail.com>",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "program:build": "anchor build --ignore-keys && node scripts/sync-idl.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:program": "npm run build && node scripts/test-program.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "npm run build && node scripts/demo.mjs",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "prepack": "npm run build",
    "package:check": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@solana/web3.js": "1.99.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "jayson": "5.0.0",
    "toml": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalpinto007/ack.git"
  },
  "homepage": "https://www.npmjs.com/package/ack-receipts",
  "bugs": {
    "url": "https://github.com/royalpinto007/ack/issues"
  },
  "keywords": [
    "solana",
    "anchor",
    "rust",
    "delivery-receipts",
    "acknowledgment",
    "ai-agents",
    "local-first",
    "cli",
    "pda",
    "acknowledgments"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "ack-receipts": "dist/cli.js"
  },
  "files": [
    "dist/",
    "idl/ack.json",
    "docs/*.md",
    "docs/*.svg",
    "docs/screenshot.png",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "bundledDependencies": [
    "@anchor-lang/core",
    "@solana/web3.js"
  ]
}
